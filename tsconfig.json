{
    "compilerOptions": {
        "target": "es2023",
        "module": "esnext",
        "lib": ["ES2023", "DOM"],
        "types": ["vite/client", "vite-plugin-pwa/client"],
        "skipLibCheck": true,
        "jsx": "react-jsx",

        /* Bundler mode: tells TS that we are using a bundler like Vite */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* Linting: strict TypeScript compiler rules */
        // Ensures there are no unused local variables (e.g. const x = 1)
        "noUnusedLocals": true,
        // Ensures there are no unused function parameters (e.g. function(a, b))
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
